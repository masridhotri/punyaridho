namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\dayli;

class DayliController extends Controller
{
    public function index(){
        $todol = dayli::all();
        return view('welcome',compact('todol'));
    }
    public function store(Request $request){

        $todolis = new dayli();
        $todolis->nama = $request->nama;
        $todolis->priotas = $request->priotas;
        
        $todolis->save();

    }
    public function toggleStatus($id)
    {
    $dayli = dayli::findOrFail($id);
    
    // Ubah status (misalnya dari 0 ke 1 atau sebaliknya)
    $dayli->status = $dayli->status == 1 ? 0 : 1;
    $dayli->save();

    return response()->json(['success' => 'Status berhasil diperbarui!', 'status' => $dayli->status]);
     }
}
